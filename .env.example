# Vercel: add these as Secrets (no NEXT_PUBLIC_ prefix required).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SITE_URL=http://localhost:3000

# Local Supabase CLI only (not needed on Vercel).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Required for in-browser auth (nav profile menu after login). On Vercel, set these
# to the same values as SUPABASE_URL and your anon/publishable key:
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Legacy names still supported if you already set them:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, NEXT_PUBLIC_SITE_URL

# Production must keep conservative defaults unless separate legal review and
# any required written authorization are documented.
COMMUNITY_TOURNAMENT_MODE=true
COMMERCIAL_AUTHORIZATION_ENABLED=false

# Server-only LiveAPI collector authentication. Generate a random 32+ character
# value and copy the same value to the observer PC's ALCL_LIVEAPI_SECRET.
LIVEAPI_INGEST_SECRET=replace-with-at-least-32-random-characters
LIVEAPI_SOURCE_KEYS=observer-pc

# Observer-PC collector settings. Keep these in .env.collector.local, not in a
# deployed public client environment.
ALCL_INGEST_URL=http://localhost:3000/api/liveapi/events
ALCL_LIVEAPI_SECRET=replace-with-the-same-server-secret
ALCL_LIVEAPI_SOURCE=observer-pc
ALCL_MATCH_ID=replace-with-scheduled-match-uuid
ALCL_LIVEAPI_HOST=127.0.0.1
ALCL_LIVEAPI_PORT=7777
